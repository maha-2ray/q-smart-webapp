# <type>(<scope>): <subject>
# 
# <body>
# 
# <footer>
#
# Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert
# Scope: (optional) e.g., auth, transactions, users, ui
# Subject: imperative, present tense, max 72 chars, no period
# Body: (optional) explain what and why, wrap at 72 chars
# Footer: (optional) reference issues, e.g., "Closes #123"
#
# Examples:
# feat(transactions): add recipient field to transaction form
# fix(auth): resolve token refresh issue
# docs: update README with setup instructions
# refactor(users): simplify user management hooks
